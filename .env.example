OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456789:AAabcDefGhIjKlmNoPQRstuVwxYZ
TELEGRAM_WEBHOOK_SECRET=pick-any-random-string-here

# Optional. Defaults to true -- shows tool calls (and reasoning, if
# enabled) as a separate message before each reply. Set to false to
# turn it off.
# SHOW_AGENT_TRACE=true

# Optional. /webhook needs to know this deployment's own URL to call
# /process. Vercel provides this automatically (as VERCEL_URL) as
# long as "System Environment Variables" is enabled in your Vercel
# project's Environment Variables settings -- you only need to set
# this yourself if you'd rather not enable that.
# APP_URL=your-project.vercel.app
